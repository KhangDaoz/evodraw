PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@evodraw-dev.xxxxx.mongodb.net/evodraw_db
ALLOWED_ORIGINS=http://localhost:5173
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
# Firebase Storage (optional — file uploads won't work without these)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Signing key for room JWTs. MUST be strong and unique — a guessable value lets
# anyone forge a token for any room. The server refuses to start without it.
# Generate with:  openssl rand -hex 32
TOKEN_SECRET=CHANGE_ME_run_openssl_rand_hex_32
# Set to 1 when running behind a reverse proxy (Render, nginx) so rate limiting
# keys on the real client IP. Defaults on when NODE_ENV=production.
# TRUST_PROXY=1
# Optional: Room activity touch interval in ms (default: 5000)
# ROOM_ACTIVITY_TOUCH_INTERVAL_MS=5000